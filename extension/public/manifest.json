{
  "manifest_version": 3,
  "name": "Job Assistant",
  "description": "Capturez et suivez vos candidatures plus facilement.",
  "version": "0.3.0",
  "permissions": ["activeTab","storage"],
  "action": {
    "default_popup": "index.html",
    "default_title": "Ouvrir Job Assistant"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}